# REGAIN Frontend Environment Variables
# After deploying CDK stacks, populate these values from CloudFormation outputs:
#   VITE_API_URL        → RegainApiStack.ApiUrl (output: RegainApiUrl)
#   VITE_USER_POOL_ID   → RegainAuthStack.UserPoolId (output: RegainUserPoolId)
#   VITE_USER_POOL_CLIENT_ID → RegainAuthStack.UserPoolClientId (output: RegainUserPoolClientId)
#
# Quick command to get values:
#   aws cloudformation describe-stacks --stack-name RegainApiStack --query "Stacks[0].Outputs"
#   aws cloudformation describe-stacks --stack-name RegainAuthStack --query "Stacks[0].Outputs"

VITE_API_URL=https://your-api-gateway-url.execute-api.us-east-1.amazonaws.com/prod
VITE_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_AWS_REGION=us-east-1
